RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# The agent under test and the compiler both run through src/mandate/llm.py.
# Set one of these. A placeholder value is rejected rather than silently
# falling back to a scripted model, which is what produced a full table of
# confidence intervals from a stub that never read the attack catalog.
# Option 1: Alibaba DashScope (Qwen 3.5 Flash)
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Option 2: Google Gemini (Gemini 3.7 Flash)
GEMINI_API_KEY=
# Optional. Free-tier quota is per key; the provider round-robins across them.
GEMINI_API_KEY_2=

# Option 3: Anthropic (Claude Opus 5)
# ANTHROPIC_API_KEY=
